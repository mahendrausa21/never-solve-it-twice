# Copy this file to .env and replace these placeholders with your own credentials.
# Never commit or share the completed .env file.
MEKO_API_KEY=your_meko_api_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional model used when GEMINI_MODEL remains unavailable after retries.
GEMINI_FALLBACK_MODEL=
DATAPACK_NAME=support-hackathon
